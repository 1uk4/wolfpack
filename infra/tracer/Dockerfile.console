# --console mode image: the tracer image + the standalone console server (scripts/build-server.mjs, built IN the Linux image) + headless chromium (playwright-core).
# Built by run-tracer.sh --console on top of the base tracer image:  docker build -f infra/tracer/Dockerfile.console --build-arg BASE=wolfpack-tracer .
ARG BASE=wolfpack-tracer
FROM ${BASE}
WORKDIR /opt/wolfpack
COPY scripts/build-server.mjs ./scripts/build-server.mjs
# NEXT_PUBLIC_WOLFPACK_HUB_URL is the only build-time console value (the /pair page link); not needed for the tracer.
RUN node scripts/build-server.mjs --out /opt/console && du -sh /opt/console
RUN useradd --create-home --shell /bin/bash console
ENV PLAYWRIGHT_BROWSERS_PATH=/opt/pw-browsers
RUN mkdir -p /opt/proof && cd /opt/proof && npm init -y >/dev/null && npm i --no-audit --no-fund playwright-core@1.52.0 \
 && npx playwright-core install --with-deps chromium && rm -rf /var/lib/apt/lists/* && chmod -R a+rX /opt/pw-browsers /opt/proof /opt/console
COPY infra/tracer/console-proof.mjs /opt/proof/console-proof.mjs
RUN chmod a+r /opt/proof/console-proof.mjs
