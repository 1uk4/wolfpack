{
	"name": "@wolfpack/desktop",
	"license": "AGPL-3.0-only",
	"version": "0.3.4",
	"private": true,
	"type": "commonjs",
	"description": "Wolfpack Console desktop shell (Electron)",
	"main": "electron/main.cjs",
	"desktopName": "wolfpack-console.desktop",
	"author": {
		"name": "Luka Flores",
		"email": "85141937+1uk4@users.noreply.github.com"
	},
	"homepage": "https://github.com/1uk4/wolfpack",
	"scripts": {
		"dev": "concurrently -k -n console,electron \"pnpm --filter @wolfpack/console run dev -p 3210\" \"until curl -sf -o /dev/null http://localhost:3210; do sleep 1; done; WOLFPACK_DEV_URL=http://localhost:3210 electron .\"",
		"electron:dev": "WOLFPACK_DEV_URL=${WOLFPACK_DEV_URL:-http://localhost:3000} electron .",
		"build:server": "pnpm --filter @wolfpack/console run build && node scripts/build-server.mjs && node scripts/smoke-server.mjs",
		"dist": "pnpm run build:server && electron-builder --mac --arm64 --publish never -c.mac.identity=null"
	},
	"dependencies": {
		"electron-updater": "^6.8.11"
	},
	"devDependencies": {
		"electron": "^45.0.0",
		"electron-builder": "26.18.0",
		"concurrently": "^10.0.5",
		"@resvg/resvg-js": "^2.6.2",
		"app-builder-lib": "26.18.0"
	}
}
