# /etc/wolfpack/console.env — root:root, mode 600. setup.sh writes it ONLY if missing. NO secrets by default: the console forwards the
# browser's own device token to the hub; it needs no WOLFPACK_HUB_TOKEN.

# Bind: loopback only (the unit refuses anything else). Port: 1024-65535, never 3141 or 3150.
CONSOLE_HOST=127.0.0.1
CONSOLE_PORT=3200

# REQUIRED. The origin the browser sees (tailscale serve, HTTPS, no path): decides the __Host- cookie names. Edit the host name.
WOLFPACK_CONSOLE_PUBLIC_ORIGIN=https://CHANGE-ME.tailnet-name.ts.net

# The hub the console talks to (server side). Today hubd listens on the tailnet IP; after step (e) of the RUNBOOK it may be 127.0.0.1.
WOLFPACK_HUB_URL=http://100.120.154.69:3150

# The hub as a phone/browser reaches it (behind serve, under /hub): the /pair page link and the Devices panel's pairing link.
# Read at runtime (no rebuild needed). Same value as hubd's HUBD_PUBLIC_URL.
HUBD_PUBLIC_URL=https://CHANGE-ME.tailnet-name.ts.net/hub

# Where the console keeps its own state (KB graph cache, settings). setup.sh creates it console:console 0700. Inside the unit's ReadWritePaths (/var/lib/console).
LH_DATA_DIR=/var/lib/console/data

# Optional, for GET /api/health's hub probe only. Leave unset: /api/health then reports on the console itself.
#WOLFPACK_HUB_TOKEN=
