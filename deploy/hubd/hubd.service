# hubd on sfo-01. Installed by deploy/hubd/setup.sh (it substitutes @NODE@ and the bind from /etc/wolfpack/hubd.env).
# Runs as the dedicated user "hubd", never as a wolf user.
[Unit]
Description=Wolfpack hub (hubd)
Documentation=file:///opt/wolfpack-hubd/current/RUNBOOK.md
# tailscaled first: HUBD_HOST is the Tailscale IP. ExecStartPre also waits for the address; Restart=on-failure covers the rest.
After=network-online.target tailscaled.service
Wants=network-online.target tailscaled.service
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=hubd
Group=hubd
# Root-owned, mode 600; systemd reads it as root before dropping privileges.
EnvironmentFile=/etc/wolfpack/hubd.env
# $$ is a literal $ for systemd; ${HUBD_HOST} is expanded by systemd from the env file.
ExecStartPre=/bin/sh -c 'for i in $$(seq 1 30); do ip -o addr show | grep -q " ${HUBD_HOST}/" && exit 0; sleep 1; done; echo "address ${HUBD_HOST} not present" >&2; exit 1'
ExecStart=@NODE@ /opt/wolfpack-hubd/current/hubd.mjs serve --data-dir ${HUBD_DATA_DIR} --host ${HUBD_HOST} --port ${HUBD_PORT}
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
UMask=0007

# State: /var/lib/hubd (ledger, registry, tokens, hub-owned KB copy and contributions).
StateDirectory=hubd
StateDirectoryMode=0700

# Hardening. Home is hidden except the specific Dewey paths bound in below.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=tmpfs
# Only these Dewey paths are visible; POSIX ACLs decide what hubd may do in them (domains/: read-only unless setup ran with --kb-write).
# The "-" prefix makes a missing path non-fatal (e.g. receipts before it exists).
BindPaths=-/home/wolf-W1hOrJ/knowledge/base/domains -/home/wolf-W1hOrJ/librarian/inbox -/home/wolf-W1hOrJ/librarian/receipts
ReadWritePaths=/var/lib/hubd
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
# node's JIT needs W+X pages, so MemoryDenyWriteExecute stays off.

[Install]
WantedBy=multi-user.target
