{
  "name": "@wolfpack/agent",
  "license": "AGPL-3.0-only",
  "version": "0.1.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "wolfpack-agent": "dist/bin/wolfpack-agent.js",
    "wolfpack-work-server": "dist/bin/wolfpack-work-server.js"
  },
  "scripts": {
    "build": "tsc --build && node -e \"import('node:fs').then(f=>{f.chmodSync('dist/bin/wolfpack-agent.js',0o755);f.chmodSync('dist/bin/wolfpack-work-server.js',0o755);})\"",
    "typecheck": "tsc --noEmit",
    "start": "node dist/bin/wolfpack-agent.js",
    "lint": "echo \"no lint configured for @wolfpack/agent\"",
    "test": "vitest run --root ../.. --config vitest.config.ts packages/agent/src"
  },
  "dependencies": {
    "@wolfpack/engine": "*",
    "@wolfpack/kb": "*",
    "@wolfpack/work-server": "*",
    "express": "^4.21.0",
    "yaml": "^2.6.0",
    "nanoid": "^5.1.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  }
}
