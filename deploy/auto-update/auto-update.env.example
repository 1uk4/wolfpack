# /etc/wolfpack/auto-update.env (root, 600). No secrets: the manifest and releases are public.
# Opt-in: the timer installs nothing unless this is 1. Kill switch (wins over everything, manual runs too):
#   touch /var/lib/wolfpack-auto-update/auto-update.disabled
WOLFPACK_AUTO_UPDATE=0
# Units in update order (one restart at a time; a failure stops the pass and holds the host until fixed or a newer release).
WOLFPACK_AUTO_UPDATE_UNITS="hubd workerd workerd-wolves wolfd console"
# wolfd releases go to these wolves (wolfd@<name>); empty = no wolfd updates.
WOLFPACK_AUTO_UPDATE_WOLVES="hal2"
