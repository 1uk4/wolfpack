MemorySwapMax=0
TasksMax=256
StandardOutput=journal
StandardError=journal
SyslogIdentifier=wolfd-@NAME@

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=tmpfs
BindPaths=@HOME@
