# Runtime secrets
keys/
# ...but the console's /api/keys route is source, not a secret dir
!apps/console/app/api/keys/
*.env
.vault_pass

# Wolf dens — living workspaces synced via Syncthing, not source
dens/

# Live knowledge bases — synced, not committed
knowledge/

# JS/TS
node_modules/
dist/
*.tsbuildinfo
# Release-version stamps written by `pnpm runtime:update` (scripts/release-version.mjs --stamp-runtime)
/packages/*/VERSION
/apps/console/VERSION

# Syncthing metadata
**/.stfolder
**/.stversions/
**/.stignore

# OS
.DS_Store

# OM session memory
.memory/

# compiled test artifacts accidentally emitted into src by ad-hoc tsc
packages/*/src/**/*.test.js
packages/*/src/**/*.test.d.ts
packages/*/src/**/*.test.js.map
packages/*/src/**/*.test.d.ts.map

.claude/
*.bak
vitest.config.js
vitest.config.d.ts
vitest.config.*.map

# Logs, coverage, editor dirs
*.log
coverage/
.idea/
.vscode/

# visual-tools renders fall back to <cwd>/viz when WOLF_DEN is unset (never commit)
viz/
.turbo/
.next/
dist-release/

# tracer --console output (screenshots)
infra/tracer/out/
