{
  "name": "@wolfpack/cli",
  "license": "AGPL-3.0-only",
  "version": "0.1.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "wolfpack": "dist/bin/wolfpack.js"
  },
  "scripts": {
    "build": "tsc --build && node -e \"import('node:fs').then(f=>{f.chmodSync('dist/bin/wolfpack.js',0o755);})\"",
    "typecheck": "tsc --noEmit",
    "lint": "echo \"no lint configured for @wolfpack/cli\"",
    "test": "vitest run --root ../.. --config vitest.config.ts packages/cli/src"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "^1.1.0",
    "@wolfpack/agents": "*",
    "@wolfpack/engine": "*",
    "@wolfpack/kb": "*",
    "esbuild": "^0.28.0",
    "nanoid": "^5.1.0",
    "tldts": "7.4.19",
    "yaml": "^2.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "@wolfpack/harness": "*"
  },
  "optionalDependencies": {
    "playwright-core": "1.63.0"
  }
}
