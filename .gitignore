# Runtime secrets
keys/
*.env
.vault_pass

# Wolf dens — living workspaces synced via Syncthing, not source
dens/

# Live knowledge bases — synced, not committed
knowledge/

# JS/TS
node_modules/
dist/
*.tsbuildinfo

# Legacy build artifacts
legacy/**/*.js
legacy/**/*.js.map
legacy/**/*.d.ts
legacy/**/*.d.ts.map

# Syncthing metadata
**/.stfolder
**/.stversions/
**/.stignore

# OS
.DS_Store

# OM session memory
.memory/

# Ephemeral/persistent visual-tools renders (never commit)
viz/

# compiled test artifacts accidentally emitted into src by ad-hoc tsc
packages/*/src/**/*.test.js
packages/*/src/**/*.test.d.ts
packages/*/src/**/*.test.js.map
packages/*/src/**/*.test.d.ts.map

.claude/
*.bak
vitest.config.js
vitest.config.d.ts
vitest.config.*.map
