# Wolfpack Retry of ONE failed component (work-wolfpack-s0Tnbth). Instance = hubd | workerd | console | wolfd. Same as wolfpack-auto-update-now@.service plus --clear-failed (lifts the held failure first). Started by the console Retry button (polkit-gated).
[Unit]
Description=Wolfpack update retry after failure of %i
Documentation=file:///opt/wolfpack-auto-update/RUNBOOK.md
After=network-online.target
Wants=network-online.target
# Not installed yet / removed: the unit reports an assert failure (the console says "update script missing on the host"), not exit 203.
AssertPathExists=/opt/wolfpack-auto-update/auto-update.mjs

[Service]
Type=oneshot
EnvironmentFile=-/etc/wolfpack/auto-update.env
ExecStart=@NODE@ /opt/wolfpack-auto-update/auto-update.mjs run --now --only %i --clear-failed
StateDirectory=wolfpack-auto-update
StateDirectoryMode=0755
TimeoutStartSec=45min
# Same hardening as wolfpack-auto-update.service (see the reasons there).
NoNewPrivileges=yes
PrivateTmp=yes
UMask=0022
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
