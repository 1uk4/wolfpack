# Wolfpack manual update of ONE component (work-wolfpack-pr6t1Y9). Instance = hubd | workerd | console | wolfd. Started by the console Update button on a card (polkit-gated) or by hand. Same as wolfpack-auto-update-now.service but `run --now --only %i`; the failed-hold and kill switch still apply.
[Unit]
Description=Wolfpack manual update of %i
Documentation=file:///opt/wolfpack-auto-update/RUNBOOK.md
After=network-online.target
Wants=network-online.target
# Not installed yet / removed: the unit reports an assert failure (the console says "update script missing on the host"), not exit 203.
AssertPathExists=/opt/wolfpack-auto-update/auto-update.mjs

[Service]
Type=oneshot
EnvironmentFile=-/etc/wolfpack/auto-update.env
ExecStart=@NODE@ /opt/wolfpack-auto-update/auto-update.mjs run --now --only %i
StateDirectory=wolfpack-auto-update
StateDirectoryMode=0755
TimeoutStartSec=45min
# Same hardening as wolfpack-auto-update.service (see the reasons there).
NoNewPrivileges=yes
PrivateTmp=yes
UMask=0022
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
