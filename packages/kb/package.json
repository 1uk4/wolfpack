{
  "name": "@wolfpack/kb",
  "license": "AGPL-3.0-only",
  "version": "0.1.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "wolfpack-kb": "dist/cli.js"
  },
  "exports": {
    ".": "./dist/index.js",
    "./shared": "./dist/shared/index.js",
    "./client": "./dist/client/index.js",
    "./librarian": "./dist/librarian/index.js",
    "./librarian/intake": "./dist/librarian/intake.js",
    "./graph": "./dist/graph/index.js",
    "./sync": "./dist/sync/index.js"
  },
  "scripts": {
    "build": "tsc --build && node -e \"import('node:fs').then(f=>{f.chmodSync('dist/cli.js',0o755);})\"",
    "typecheck": "tsc --noEmit",
    "lint": "echo \"no lint configured for @wolfpack/kb\"",
    "test": "vitest run --root ../.. --config vitest.config.ts packages/kb/src"
  },
  "dependencies": {
    "@wolfpack/engine": "*",
    "@wolfpack/protocol": "*",
    "yaml": "^2.6.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "vite-node": "^3.2.4"
  }
}
