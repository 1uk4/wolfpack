# hubd on sfo-01. Installed by deploy/hubd/setup.sh (it substitutes @NODE@; the bind comes from /etc/wolfpack/hubd.env).
# Runs as the dedicated user "hubd", never as a wolf user. Everything hubd owns (ledger, KB, curator lanes and receipts) lives under
# /var/lib/hubd; no wolf's home is bound (Dewey and his paths are retired, 2026-11-06).
[Unit]
Description=Wolfpack hub (hubd)
Documentation=file:///opt/wolfpack-hubd/current/RUNBOOK.md
# tailscaled first: HUBD_HOST is the Tailscale IP. ExecStartPre also waits for the address; Restart=on-failure covers the rest.
After=network-online.target tailscaled.service
Wants=network-online.target tailscaled.service
# Restart forever is intended (owner decision: self-healing is restart only). Watchdog and start-timeout restarts never trip this
# limit: a watchdog kill comes at least WatchdogSec (30 s) after READY, plus RestartSec=5, so starts are >= 35 s apart (at most ~8 per
# 300 s, under the burst of 10); a missing READY costs TimeoutStartSec=300 per attempt. So a broken notify path means endless
# restarts, never a unit stuck in "failed"; the journal says why ("Watchdog timeout" / "start operation timed out", plus hubd's
# once-only "systemd-notify ... failed" line).
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
# notify + watchdog (work-wolfpack-94pN3co): hubd sends READY=1 once it listens and WATCHDOG=1 every WatchdogSec/2 from its main event
# loop, so a frozen loop is killed and restarted by Restart=on-failure (a watchdog kill counts as a failure).
Type=notify
# The messages come from a spawned `systemd-notify` child, not from hubd's own PID (node has no unix datagram sockets), so
# NotifyAccess=main or exec would reject them; all accepts any process in the unit's cgroup. Cost: any process in that cgroup,
# curator children included, could send the manager READY/WATCHDOG/STATUS for this unit. They all run as user hubd under
# NoNewPrivileges, so this only lets hubd's own code mislead systemd about hubd, nothing more.
NotifyAccess=all
WatchdogSec=30s
# SIGKILL instead of the default SIGABRT: a frozen hub is restarted without writing a core dump (node heap, tokens in memory).
WatchdogSignal=SIGKILL
# Covers ExecStartPre (up to 30 s waiting for the Tailscale address) plus the KB recovery and startup scan before hubd listens.
TimeoutStartSec=300
User=hubd
Group=hubd
# Root-owned, mode 600; systemd reads it as root before dropping privileges.
EnvironmentFile=/etc/wolfpack/hubd.env
# Guards (bash; $$ is a literal $ for systemd): port is numeric, 1024-65535 and not 3141 (wolfpack-agent); bind is IPv4 and not a wildcard.
ExecStartPre=/bin/bash -c '[[ "$${HUBD_PORT}" =~ ^[0-9]+$$ ]] && p=$$((10#$${HUBD_PORT})) && (( p >= 1024 && p <= 65535 && p != 3141 )) || { echo "bad HUBD_PORT=$${HUBD_PORT} (1024-65535, not 3141)" >&2; exit 1; }; [[ "$${HUBD_HOST}" =~ ^([0-9]{1,3}[.]){3}[0-9]{1,3}$$ && "$${HUBD_HOST}" != 0.0.0.0 ]] || { echo "bad HUBD_HOST" >&2; exit 1; }'
# Wait (up to 30 s) for the bind address to exist. Pure bash on /proc (no `ip`: it needs AF_NETLINK, which RestrictAddressFamilies denies).
# Exact match: a fib_trie line "|-- <ip>" (dots escaped, anchored) followed by "/32 host LOCAL" (so 100.1.1.1 never matches 100.1.1.10).
ExecStartPre=/bin/bash -c 'h=$${HUBD_HOST//./[.]}; for i in $$(seq 1 30); do grep -E -A1 "^ *[|]-- $$h$$" /proc/net/fib_trie | grep -Fq "/32 host LOCAL" && exit 0; sleep 1; done; echo "address $${HUBD_HOST} not present" >&2; exit 1'
ExecStart=@NODE@ /opt/wolfpack-hubd/current/hubd.mjs serve --data-dir ${HUBD_DATA_DIR} --host ${HUBD_HOST} --port ${HUBD_PORT}
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
# 0022, not 0077: files are written 644. The data dir is 0700, so the files inside it are not reachable by others; tokens.json is
# written 0600 explicitly.
UMask=0022

# State: /var/lib/hubd (ledger, registry, tokens, hub-owned kb/base, kb-rev).
StateDirectory=hubd
StateDirectoryMode=0700

# Hardening. Home is hidden; the only writable path is the state dir.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=tmpfs
ReadWritePaths=/var/lib/hubd
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
# A filtered syscall returns EPERM instead of killing hubd with SIGSYS.
SystemCallErrorNumber=EPERM
# node's JIT needs W+X pages, so MemoryDenyWriteExecute stays off.

[Install]
WantedBy=multi-user.target
