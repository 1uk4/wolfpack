#!/usr/bin/env bash
# pi-wolf startup wrapper for {{ wolf_name }} — launches pi in a detached tmux
# session at the den, waits for the TUI, then activates the Telegram bridge
# with /telegram-connect. Deployed by the `pi` role.
#
# Works for both layouts: dedicated (default tmux socket) and co-located (a
# per-wolf `tmux -L {{ wolf_name }}` socket + PI_CODING_AGENT_DIR pointing at
# this wolf's own config dir), so several wolves can share one user.
set -u

SESSION="{{ wolf_name }}"
DEN="{{ pi_den }}"
TMUX="/usr/bin/tmux -L {{ wolf_name }}"
export HOME="/home/{{ wolf_user }}"
export PI_CODING_AGENT_DIR="{{ pi_config_dir }}"
export PATH="$HOME/.bun/bin:$HOME/.local/bin:/usr/local/bin:/usr/bin:/bin"

# Load ANTHROPIC_API_KEY + TELEGRAM_BOT_TOKEN.
[ -r "{{ pi_config_dir }}/pi.env" ] && set -a && . "{{ pi_config_dir }}/pi.env" && set +a

# Start pi detached, with the den as cwd so it loads den/AGENTS.md.
$TMUX new-session -d -s "$SESSION" -c "$DEN" 'pi'

# Wait for the TUI to render, then send /telegram-connect.
connected=0
for _ in $(seq 1 30); do
  sleep 4
  pane="$($TMUX capture-pane -t "$SESSION" -p -S -100 2>/dev/null || true)"
  if printf '%s' "$pane" | grep -qiE 'context files|skills|pi v[0-9]|esc|ctrl\+'; then
    $TMUX send-keys -t "$SESSION" '/telegram-connect' Enter
    connected=1
    break
  fi
done

# Fallback: try once even if we never matched a banner.
if [ "$connected" -eq 0 ]; then
  $TMUX send-keys -t "$SESSION" '/telegram-connect' Enter
fi

exit 0
