{
  "name": "@wolfpack/workerd",
  "license": "AGPL-3.0-only",
  "version": "0.1.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "bin": {
    "workerd": "dist/bin/workerd.js"
  },
  "scripts": {
    "build": "tsc --build && node -e \"import('node:fs').then(f=>{f.chmodSync('dist/bin/workerd.js',0o755);})\"",
    "typecheck": "tsc --noEmit",
    "lint": "echo \"no lint configured for @wolfpack/workerd\"",
    "test": "vitest run --root ../.. --config vitest.config.ts packages/workerd/src"
  },
  "dependencies": {
    "@wolfpack/engine": "*",
    "@wolfpack/harness": "*",
    "@wolfpack/kb": "*",
    "@wolfpack/protocol": "*",
    "ws": "~8.22.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.2",
    "@wolfpack/client": "*",
    "@wolfpack/hubd": "*",
    "typescript": "^5.7.0"
  }
}
