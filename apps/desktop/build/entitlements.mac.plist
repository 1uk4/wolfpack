<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- V8 compiles JavaScript at runtime, which the hardened runtime blocks without this. -->
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<!-- Dictation records the microphone (Developer ID apps use audio-input, not the sandbox's device.microphone). -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
