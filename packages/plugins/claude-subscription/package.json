{
  "name": "@wolfpack/plugin-claude-subscription",
  "private": true,
  "license": "AGPL-3.0-only",
  "version": "0.1.0",
  "type": "module",
  "description": "Attaches a Claude subscription (Pro/Max) to Wolfpack as the claude-subscription provider.",
  "wolfpack": {
    "apiVersion": 1,
    "entry": "./dist/index.js",
    "requiredEnv": ["CLAUDE_CODE_OAUTH_TOKEN", "CLAUDE_CODE_PATH", "WOLF_DEN"],
    "optionalEnv": ["CLAUDE_CODE_NODE"],
    "providers": ["claude-subscription"],
    "engineProviders": ["claude-subscription"]
  },
  "scripts": {
    "pack": "node scripts/pack.mjs",
    "test": "vitest run --project default --root ../../.. --config vitest.config.ts packages/plugins/claude-subscription/src"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.321"
  },
  "devDependencies": {
    "@wolfpack/engine": "*",
    "@wolfpack/harness": "*",
    "esbuild": "^0.28.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
