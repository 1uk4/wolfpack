# /etc/wolfpack/hubd.env — root:root, mode 600. NO secrets belong here by default (auth is device tokens via `hubd pair`).
# setup.sh writes this file only if it does not exist; it fills HUBD_HOST from `tailscale ip -4`.

# Bind: the Tailscale IP (or 127.0.0.1). Never 0.0.0.0. Port: 1024-65535, never 3141 (wolfpack-agent).
HUBD_HOST=100.120.154.69
HUBD_PORT=3150
HUBD_DATA_DIR=/var/lib/hubd

# Optional: base URL clients reach (used for pairing QR codes).
#HUBD_PUBLIC_URL=http://100.120.154.69:3150
# Optional: console URL the browser pairing page redirects to.
#HUBD_CONSOLE_URL=

# Do NOT set HUBD_INBOX_ROOT / HUBD_RECEIPTS_ROOT: contribution lanes and receipts are hub-owned under HUBD_DATA_DIR/kb/ops, and the curator
# refuses to start when they are set (the old wolf-side librarian lanes in a wolf's home are retired).

# hubd writes the KB tree (it is the hub), so the worker-mirror write guard must be off here. Set on hub and agent hosts only; never on workers.
WOLFPACK_KB_WRITER=1

# Not configurable by env (library defaults, no action needed): KB poll/settle intervals (kbPollMs, kbSettleMs), relay and link timers.

# --- Hub curator (work-wolfpack-tPBXKuJ): the KB sweep runs inside hubd (the only KB curator since 2026-11-06). ---
# On: hubd runs the sweep on <HUBD_DATA_DIR>/kb/ops/contributions every HUBD_CURATOR_POLL_MS and commits entries itself. It REFUSES to start
# unless HUBD_INBOX_ROOT / HUBD_RECEIPTS_ROOT are unset. Needs CLAUDE_CODE_OAUTH_TOKEN (subscription token) and Ollama; see RUNBOOK.md section 8.
# Default 0 so a fresh `setup` starts healthy without model credentials or Ollama. sfo-01 sets HUBD_CURATOR=1 in its own /etc/wolfpack/hubd.env
# (with the subscription token and the embedding service); setup never overwrites an existing env file.
HUBD_CURATOR=0
#HUBD_CURATOR_POLL_MS=60000
# models.json for the sweep engine (the resolved model table, as shipped beside a wolf). Needs the model transport's credentials for user hubd.
#HUBD_CURATOR_MODELS=/etc/wolfpack/curator-models.json
# Embedding service (Ollama) for placement (passed as options; the process environment is not changed). NOTE a non-nomic model also needs WOLFPACK_EMBED_MODEL in the environment (the task prefix is keyed on it); default http://127.0.0.1:11434 / nomic-embed-text.
#HUBD_EMBED_URL=http://127.0.0.1:11434
#HUBD_EMBED_MODEL=nomic-embed-text
