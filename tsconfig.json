{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "composite": true
  },
  "exclude": ["infra/**", "extensions/**", "node_modules/**"],
  "references": [
    { "path": "packages/engine" },
    { "path": "packages/memory" },
    { "path": "packages/kb" },
    { "path": "packages/agent" },
    { "path": "packages/cli" }
  ]
}
