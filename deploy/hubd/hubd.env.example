# /etc/wolfpack/hubd.env — root:root, mode 600. NO secrets belong here by default (auth is device tokens via `hubd pair`).
# setup.sh writes this file only if it does not exist; it fills HUBD_HOST from `tailscale ip -4`.

# Bind: the Tailscale IP (or 127.0.0.1). Never 0.0.0.0. Port: 1024-65535, never 3141 (wolfpack-agent).
HUBD_HOST=100.120.154.69
HUBD_PORT=3150
HUBD_DATA_DIR=/var/lib/hubd

# Optional: base URL clients reach (used for pairing QR codes).
#HUBD_PUBLIC_URL=http://100.120.154.69:3150
# Optional: console URL the browser pairing page redirects to.
#HUBD_CONSOLE_URL=

# Librarian lanes (read by hubd, ticket 7). INBOX: hubd writes contributions to <root>/<wolf>/<denTopicId>-<hash10>.md (+ _bad/ quarantine);
# RECEIPTS: hubd polls <root>/<wolf>/*.md written by Dewey and relays them to workers. Unset = hub-owned dirs under HUBD_DATA_DIR/kb/ops.
# Use the REAL /home paths (the /var/wolfpack/kb/ops/* symlinks are not bound into the sandbox).
HUBD_INBOX_ROOT=/home/wolf-W1hOrJ/librarian/inbox
HUBD_RECEIPTS_ROOT=/home/wolf-W1hOrJ/librarian/receipts

# hubd writes the KB tree (it is the hub), so the worker-mirror write guard must be off here. Set on hub and agent hosts only; never on workers.
WOLFPACK_KB_WRITER=1

# Not configurable by env (library defaults, no action needed): KB poll/settle intervals (kbPollMs, kbSettleMs), relay and link timers.
