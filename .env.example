# Wolfpack secrets — copy this file to .env and fill in real values.
#
#   cp .env.example .env
#
# Never commit .env — it's in .gitignore.

# Tailscale reusable auth key.
# Get one at: https://login.tailscale.com/admin/settings/keys
# Click "Generate auth key", enable "Reusable", copy the tskey-auth-... value.
TAILSCALE_AUTHKEY=tskey-auth-REPLACE_ME

# Telegram bot token(s) — one per wolf, named TELEGRAM_BOT_TOKEN_<WOLFNAME>.
# Create a bot via @BotFather on Telegram:
#   1. DM @BotFather, send /newbot
#   2. Pick a name and a username ending in 'bot'
#   3. Copy the token (looks like 1234567890:AAH...)
# One per Claude wolf, named TELEGRAM_BOT_TOKEN_<WOLFNAME>.
TELEGRAM_BOT_TOKEN_HAL=REPLACE_ME
TELEGRAM_BOT_TOKEN_SNAPJACK_BI=REPLACE_ME

# Wolfpack command-center bot token — a separate BotFather bot from any wolf.
# Only 1uk4 (owner_telegram_id in inventory) can issue commands against it.
TELEGRAM_BOT_TOKEN_WOLFPACK_CC=REPLACE_ME

# ---------------------------------------------------------------------------
# PI wolves (experimental agent type — provisioned with ./bootstrap-pi.sh)
# ---------------------------------------------------------------------------

# Anthropic API key for pi-wolves (headless auth). If left empty/REPLACE_ME,
# pi pauses for a one-time interactive /login (Claude subscription) instead.
#   Get one at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=REPLACE_ME

# Telegram bot token per pi-wolf, named TELEGRAM_BOT_TOKEN_<WOLFNAME>.
# Same @BotFather flow as the Claude wolves. Referenced from inventory as
# telegram_bot_token, and the pi-telegram bridge reads it via $TELEGRAM_BOT_TOKEN.
TELEGRAM_BOT_TOKEN_PILOT=REPLACE_ME

# Your Mac's Syncthing device ID — used as the hub for wolf dens and shared/.
# Get it from the Syncthing web UI on your Mac (http://localhost:8384):
#   top-right menu → "Show ID" → copy the 56-character ID
# Looks like: ABCDE12-FGHIJ34-KLMNO56-PQRST78-UVWXY90-ABCDE12-FGHIJ34-KLMNO56
MAC_SYNCTHING_DEVICE_ID=REPLACE_ME
