# Wolfpack console (Next.js standalone) on sfo-01. Installed by deploy/console/setup.sh (it substitutes @NODE@; bind/port come from /etc/wolfpack/console.env).
# Binds 127.0.0.1 ONLY: the tailnet reaches it through `tailscale serve` (deploy/tailscale/serve.sh), which terminates HTTPS.
# Runs as the dedicated user "console": no access to /home, no hub token needed (the browser's own device token is forwarded).
[Unit]
Description=Wolfpack console (Next.js standalone)
Documentation=file:///opt/wolfpack-console/current/RUNBOOK.md
After=network-online.target tailscaled.service
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=console
Group=console
# Pack-health Logs (work-wolfpack-yM3uTlj): read the system journal (journalctl -u hubd|workerd*|wolfd@*). Read-only; nothing else changes.
SupplementaryGroups=systemd-journal
# Root-owned, mode 600; systemd reads it as root before dropping privileges.
EnvironmentFile=/etc/wolfpack/console.env
Environment=NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 HOME=/var/lib/console
# Guards ($$ is a literal $): loopback bind only; port numeric 1024-65535 and not 3141 (wolfpack-agent) / 3150 (hubd); a public origin is set (cookie names).
ExecStartPre=/bin/bash -c '[[ "$${CONSOLE_HOST}" == 127.0.0.1 ]] || { echo "CONSOLE_HOST must be 127.0.0.1" >&2; exit 1; }; [[ "$${CONSOLE_PORT}" =~ ^[0-9]+$$ ]] && p=$$((10#$${CONSOLE_PORT})) && (( p >= 1024 && p <= 65535 && p != 3141 && p != 3150 )) || { echo "bad CONSOLE_PORT=$${CONSOLE_PORT}" >&2; exit 1; }; [[ "$${WOLFPACK_CONSOLE_PUBLIC_ORIGIN}" == https://* ]] || { echo "WOLFPACK_CONSOLE_PUBLIC_ORIGIN must be https://... (see console.env)" >&2; exit 1; }'
# Next's standalone server reads PORT and HOSTNAME; systemd expands ${VAR} inside an argument.
WorkingDirectory=/opt/wolfpack-console/current
ExecStart=/usr/bin/env PORT=${CONSOLE_PORT} HOSTNAME=${CONSOLE_HOST} @NODE@ /opt/wolfpack-console/current/server.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
UMask=0077

# State: /var/lib/console (HOME; Next's cache, engine scratch). Nothing there is needed across restarts.
StateDirectory=console
StateDirectoryMode=0700

# Hardening (as hubd.service). No home access at all.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/console
# The release-channel file (written by the pack panel); setup.sh of deploy/auto-update creates it. The `-` prefix: not an error before that setup ran.
ReadWritePaths=-/var/lib/wolfpack-subscription
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
# node's JIT needs W+X pages, so MemoryDenyWriteExecute stays off.

[Install]
WantedBy=multi-user.target
