{
  "name": "@wolfpack/harness",
  "version": "0.1.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./extension": {
      "types": "./dist/extension-api.d.ts",
      "default": "./dist/extension-api.js"
    },
    "./memory": {
      "types": "./dist/memory/index.d.ts",
      "default": "./dist/memory/index.js"
    },
    "./engine": {
      "types": "./dist/engine/index.d.ts",
      "default": "./dist/engine/index.js"
    },
    "./wolfd": {
      "types": "./dist/wolfd/index.d.ts",
      "default": "./dist/wolfd/index.js"
    }
  },
  "bin": {
    "wolfpack-harness": "dist/bin/harness.js",
    "wolfd": "dist/bin/wolfd.js"
  },
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --noEmit",
    "start": "node dist/bin/harness.js",
    "lint": "echo \"no lint configured for @wolfpack/harness\"",
    "test": "vitest run --root ../.. --config vitest.config.ts packages/harness/src"
  },
  "dependencies": {
    "@earendil-works/chord": "^1.4.0",
    "@earendil-works/pi-ai": "^1.4.0",
    "@earendil-works/pi-durable": "^1.4.0",
    "grammy": "^1.21.0",
    "yaml": "^2.6.0",
    "@wolfpack/protocol": "*",
    "@wolfpack/engine": "*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "@wolfpack/client": "*"
  }
}
