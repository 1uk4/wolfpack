{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "composite": true
  },
  "files": [],
  "exclude": ["infra/**", "extensions/**", "apps/**", "node_modules/**", "vitest.config.ts"],
  "references": [
    { "path": "packages/engine" },
    { "path": "packages/memory" },
    { "path": "packages/kb" },
    { "path": "packages/client" },
    { "path": "packages/protocol" },
    { "path": "packages/harness" },
    { "path": "packages/workerd" },
    { "path": "packages/agent" },
    { "path": "packages/cli" },
    { "path": "packages/workspaces" }
  ]
}
