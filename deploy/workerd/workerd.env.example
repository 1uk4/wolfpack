# /etc/wolfpack/workerd.env — root:root, mode 600. NO secrets here (the hub token lives in /var/lib/workerd/hub.json, written by `workerd pair`).
# setup.sh writes this file only if it does not exist.

# LINK-ONLY: open the hub link + KB sync, announce the wolves below, supervise and spawn NOTHING. Hal keeps running from wolf-ETAy7b.service.
# setup.sh refuses (WOULD FAIL in dry-run) if this is not 1 or the announce list is empty.
WORKERD_LINK_ONLY=1
# Wolf names announced in hello (must already be registered on the hub with host sfo-01; the hub registry decides their domains).
WORKERD_ANNOUNCE=hal
# Hal writes contributions straight into Dewey's inbox on this disk: the link feed must stay off.
WORKERD_FEED=0
# Mirror layout "base": <mirror>/domains/<d>/..., so Hal's KB_BASE can point straight at the mirror dir.
WORKERD_KB_LAYOUT=base
# Hub KB mirror outside the private state dir, readable by group wolfpack-kb (workerd and Hal are members; dir is workerd:wolfpack-kb 2750).
# GROUP_READ=1 writes mirror files 0640 / dirs 0750 despite UMask=0077; hub.json, outbox and .sync/ stay private. Unset = old behaviour.
WORKERD_KB_MIRROR_DIR=/var/lib/workerd-kb
WORKERD_KB_MIRROR_GROUP_READ=1
# Config dir: hub.json (from `workerd pair`) and outbox/ (the mirror is WORKERD_KB_MIRROR_DIR above; without it, <dir>/kb-mirror).
WORKERD_CONFIG_DIR=/var/lib/workerd
# Receipts (only ever written for announced wolves) stay inside the sandbox.
KB_OPS=/var/lib/workerd/ops
HOME=/var/lib/workerd
# HTTP listener (cannot be disabled): loopback only. Never 3141 (wolfpack-agent), 3150 (hubd), 7141 (Mac workerd).
WORKERD_HOST=127.0.0.1
WORKERD_PORT=7142
